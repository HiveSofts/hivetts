import { VerticalBox } from "std-widgets.slint";
import { AppHeader } from "components/app-header.slint";
import { StatusBar } from "components/status-bar.slint";
import { TabNavigation } from "components/tab-navigation.slint";
import { ModelsTab } from "tabs/models.slint";
import { SettingsTab } from "tabs/settings.slint";
import { SpeechToTextTab } from "tabs/speech-to-text.slint";
import { TextToSpeechTab } from "tabs/text-to-speech.slint";

export component AppWindow inherits Window {
    title: "HiveTTS";
    width: 940px;
    height: 800px;

    in-out property <string> speech-text: "";
    in-out property <string> transcript-text: "";
    in-out property <string> model-path: "";
    in-out property <string> piper-executable: "";
    in-out property <string> piper-voice: "";
    in-out property <string> language: "auto";
    in-out property <string> theme: "system";
    in-out property <float> speech-rate: 1.0;
    in-out property <string> status-text: "Ready";
    in-out property <bool> is-recording: false;
    in-out property <string> current-tab: "tts";
    in-out property <string> text-stats: "0 characters · 0 words";
    in-out property <string> export-path: "";
    in-out property <string> text-file-path: "";
    in-out property <string> audio-file-path: "";

    callback speak(string);
    callback start-recording();
    callback stop-recording();
    callback load-text(string);
    callback export-wav(string);
    callback transcribe-file(string);
    callback save-settings();
    callback download-model(string);
    callback update-text-stats(string);

    changed speech-text => {
        root.update-text-stats(root.speech-text);
    }

    background: root.theme == "dark" ? #111827 : #f5f7fb;

    Rectangle {
        background: root.theme == "dark" ? #111827 : #f5f7fb;

        VerticalBox {
            padding: 22px;
            spacing: 14px;

            AppHeader {
                theme: root.theme;
                toggle-theme => {
                    root.theme = root.theme == "dark" ? "light" : "dark";
                }
                save-settings => {
                    root.save-settings();
                }
            }

            TabNavigation {
                current-tab <=> root.current-tab;
            }

            if root.current-tab == "tts": TextToSpeechTab {
                theme: root.theme;
                speech-text <=> root.speech-text;
                text-stats: root.text-stats;
                export-path <=> root.export-path;
                text-file-path <=> root.text-file-path;
                speak(text) => {
                    root.speak(text);
                }
                export-wav(path) => {
                    root.export-wav(path);
                }
                load-text(path) => {
                    root.load-text(path);
                }
            }

            if root.current-tab == "stt": SpeechToTextTab {
                theme: root.theme;
                is-recording: root.is-recording;
                transcript-text <=> root.transcript-text;
                audio-file-path <=> root.audio-file-path;
                start-recording => {
                    root.start-recording();
                }
                stop-recording => {
                    root.stop-recording();
                }
                transcribe-file(path) => {
                    root.transcribe-file(path);
                }
            }

            if root.current-tab == "models": ModelsTab {
                theme: root.theme;
                download-model(model) => {
                    root.download-model(model);
                }
            }

            if root.current-tab == "settings": SettingsTab {
                theme: root.theme;
                model-path <=> root.model-path;
                piper-executable <=> root.piper-executable;
                piper-voice <=> root.piper-voice;
                language <=> root.language;
                speech-rate <=> root.speech-rate;
                toggle-theme => {
                    root.theme = root.theme == "dark" ? "light" : "dark";
                }
            }

            StatusBar {
                theme: root.theme;
                status-text: root.status-text;
            }
        }
    }
}
