import { StatusBar } from "components/status-bar.slint";
import { SideNavigation } from "components/side-navigation.slint";
import { HubModel, LanguageOption, ModelsTab } from "tabs/models.slint";
import { SpeechToTextTab } from "tabs/speech-to-text.slint";
import { TextToSpeechTab, VoiceRow } from "tabs/text-to-speech.slint";

export component AppWindow inherits Window {
    title: "HiveTTS";
    preferred-width: 1100px;
    preferred-height: 820px;
    min-width: 780px;
    min-height: 600px;

    in-out property <string> speech-text: "";
    in-out property <string> transcript-text: "";
    in-out property <string> model-path: "";
    in-out property <string> piper-executable: "";
    in-out property <string> piper-voice: "";
    in-out property <string> language: "auto";
    in-out property <string> theme: "system";
    in-out property <float> speech-rate: 1.0;
    in-out property <string> status-text: "Ready";
    in-out property <bool> is-recording: false;
    in-out property <string> current-tab: "tts";
    in-out property <string> text-stats: "0 characters · 0 words";
    in-out property <string> export-path: "";
    in-out property <string> text-file-path: "";
    in-out property <string> audio-file-path: "";
    in-out property <string> voice: "female";
    in-out property <string> tts-language: "fa";
    // Voice Settings – speaker style and prosody controls.
    in-out property <string> voice-style: "standard";
    in-out property <string> speech-tone: "neutral";
    in-out property <float> pitch: 0;
    in-out property <float> volume: 1.0;
    in-out property <float> pause-sentence: 0.5;
    in-out property <float> pause-paragraph: 1.2;
    in-out property <string> auto-save-directory: "";
    in-out property <string> last-generated-file: "";
    in-out property <[string]> tts-voice-labels: ["Built-in engine (eSpeak NG)"];
    in property <[string]> tts-voice-model-ids: [""];
    in property <[string]> tts-voice-model-files: [""];
    in property <[string]> tts-voice-languages: [""];
    in-out property <int> tts-voice-index: 0;
    // Categorized downloaded voice models shown as a grouped list on the TTS page.
    in property <[VoiceRow]> tts-voice-rows: [];
    in-out property <int> tts-voice-row-selected-index: 0;
    in-out property <[string]> tts-language-labels: [
        "Persian (fa)",
        "English (en)",
        "Arabic (ar)",
        "Turkish (tr)",
    ];
    in property <[string]> tts-language-codes: ["fa", "en", "ar", "tr"];
    in-out property <int> tts-language-index: 0;
    in property <string> installed-language-summary: "";
    in-out property <[HubModel]> model-cards: [];
    // Categorized downloaded STT models for the Speech-to-Text selector.
    in property <[string]> stt-model-labels: [];
    in property <[string]> stt-model-paths: [];
    in-out property <int> stt-model-index: 0;
    in property <[LanguageOption]> language-options: [];
    in property <[string]> language-option-labels: [];
    in-out property <string> model-download-progress-text: "";
    in-out property <float> model-download-progress: 0;
    in-out property <bool> model-download-progress-indeterminate: false;
    in-out property <string> active-model-download-id: "";

    callback speak(string);
    callback start-recording();
    callback stop-recording();
    callback load-text(string);
    callback export-wav(string);
    callback export-mp3(string);
    callback open-export-folder(string);
    callback transcribe-file(string);
    callback save-settings();
    callback download-model(string);
    callback update-text-stats(string);
    callback refresh-models(string, string, string, string, string, string);
    callback search-languages(string);
    callback download-hub-model(string, string);
    callback cancel-model-download(string);
    callback open-model-folder(string);
    callback open-hub-repository(string);
    callback delete-model(string);
    callback language-changed(int);
    callback voice-changed(int);
    callback voice-picked(int);
    callback refresh-tts-voices();
    callback refresh-stt-models();

    changed speech-text => {
        root.update-text-stats(root.speech-text);
    }

    changed model-path => {
        root.save-settings();
    }
    changed piper-executable => {
        root.save-settings();
    }
    changed piper-voice => {
        root.save-settings();
    }
    changed language => {
        root.save-settings();
    }
    changed speech-rate => {
        root.save-settings();
    }
    changed voice => {
        root.save-settings();
    }
    changed tts-language => {
        root.save-settings();
    }
    changed voice-style => {
        root.save-settings();
    }
    changed speech-tone => {
        root.save-settings();
    }
    changed pitch => {
        root.save-settings();
    }
    changed volume => {
        root.save-settings();
    }
    changed pause-sentence => {
        root.save-settings();
    }
    changed pause-paragraph => {
        root.save-settings();
    }
    changed auto-save-directory => {
        root.save-settings();
    }
    changed theme => {
        root.save-settings();
    }
    changed tts-language-index => {
        root.language-changed(root.tts-language-index);
    }
    changed tts-voice-index => {
        root.voice-changed(root.tts-voice-index);
    }
    changed current-tab => {
        // Keep the voice lists and language categorization fresh when the
        // TTS or Models pages open, and the STT model list on its page.
        if root.current-tab == "tts" || root.current-tab == "models" {
            root.refresh-tts-voices();
        }
        if root.current-tab == "stt" {
            root.refresh-stt-models();
        }
    }

    background: root.theme == "dark" ? #0b1120 : #eef2f8;

    HorizontalLayout {
        spacing: 16px;
        padding: 16px;

        SideNavigation {
            theme: root.theme;
            current-tab <=> root.current-tab;
            nav-ids: ["tts", "stt", "models"];
            nav-labels: ["Text to Speech", "Speech to Text", "Models"];
            toggle-theme => {
                root.theme = root.theme == "dark" ? "light" : "dark";
            }
        }

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            if root.current-tab == "tts": TextToSpeechTab {
                theme: root.theme;
                speech-text <=> root.speech-text;
                text-stats: root.text-stats;
                export-path <=> root.export-path;
                text-file-path <=> root.text-file-path;
                voice <=> root.voice;
                voice-style <=> root.voice-style;
                speech-tone <=> root.speech-tone;
                pitch <=> root.pitch;
                volume <=> root.volume;
                speech-rate <=> root.speech-rate;
                pause-sentence <=> root.pause-sentence;
                pause-paragraph <=> root.pause-paragraph;
                auto-save-directory <=> root.auto-save-directory;
                last-generated-file: root.last-generated-file;
                voice-labels: root.tts-voice-labels;
                voice-model-ids: root.tts-voice-model-ids;
                voice-selected-index <=> root.tts-voice-index;
                voice-rows: root.tts-voice-rows;
                voice-row-selected-index <=> root.tts-voice-row-selected-index;
                voice-picked(row) => {
                    root.voice-picked(row);
                }
                language-labels: root.tts-language-labels;
                language-selected-index <=> root.tts-language-index;
                installed-summary: root.installed-language-summary;
                speak(text) => {
                    root.speak(text);
                }
                export-wav(path) => {
                    root.export-wav(path);
                }
                export-mp3(path) => {
                    root.export-mp3(path);
                }
                open-export-folder(path) => {
                    root.open-export-folder(path);
                }
                load-text(path) => {
                    root.load-text(path);
                }
            }

            if root.current-tab == "stt": SpeechToTextTab {
                theme: root.theme;
                transcript-text: root.transcript-text;
                is-recording: root.is-recording;
                audio-file-path <=> root.audio-file-path;
                model-path <=> root.model-path;
                model-labels: root.stt-model-labels;
                model-paths: root.stt-model-paths;
                model-selected-index <=> root.stt-model-index;
                piper-executable <=> root.piper-executable;
                piper-voice <=> root.piper-voice;
                language <=> root.language;
                speech-rate <=> root.speech-rate;
                start-recording => {
                    root.start-recording();
                }
                stop-recording => {
                    root.stop-recording();
                }
                transcribe-file(path) => {
                    root.transcribe-file(path);
                }
            }

            if root.current-tab == "models": ModelsTab {
                theme: root.theme;
                installed-summary: root.installed-language-summary;
                models <=> root.model-cards;
                language-options: root.language-options;
                language-option-labels: root.language-option-labels;
                search-languages(query) => {
                    root.search-languages(query);
                }
                download-progress-text <=> root.model-download-progress-text;
                download-progress <=> root.model-download-progress;
                download-progress-indeterminate: root.model-download-progress-indeterminate;
                active-download-id <=> root.active-model-download-id;
                download-model(model) => {
                    root.download-model(model);
                }
                refresh-models(query, category, max-size, language, framework, hardware) => {
                    root.refresh-models(query, category, max-size, language, framework, hardware);
                }
                download-hub-model(model, task) => {
                    root.download-hub-model(model, task);
                }
                cancel-download(model) => {
                    root.cancel-model-download(model);
                }
                open-model-folder(path) => {
                    root.open-model-folder(path);
                }
                open-hub-repository(model) => {
                    root.open-hub-repository(model);
                }
                delete-model(model) => {
                    root.delete-model(model);
                }
            }

            Rectangle { }

            StatusBar {
                theme: root.theme;
                status-text: root.status-text;
                busy: root.is-recording || root.active-model-download-id != "";
            }
        }
    }
}
