import { Button, ComboBox, LineEdit, Slider, TextEdit, VerticalBox } from "std-widgets.slint";
import { PageHeader } from "../components/page-header.slint";

// One row of the categorized voice-model list: a language header or a
// selectable voice entry mapped back to its entry by entry-index.
export struct VoiceRow {
    is-header: bool,
    text: string,
    entry-index: int,
    selected: bool,
}

// Workspace card for advanced speaking, prosody control, and audio export.
export component TextToSpeechTab inherits Rectangle {
    pure function voice-to-index(voice: string) -> int {
        return voice == "female" ? 0 : voice == "male" ? 1 : voice == "child" ? 2 :
            voice == "whisper" ? 3 : voice == "grotesque" ? 4 : -1;
    }
    pure function emotion-to-index(emotion: string) -> int {
        return emotion == "neutral" ? 0 : emotion == "happy" ? 1 : emotion == "sad" ? 2 :
            emotion == "formal" ? 3 : emotion == "friendly" ? 4 : emotion == "excited" ? 5 :
            emotion == "calm" ? 6 : -1;
    }

    in property <string> theme: "system";
    in-out property <string> speech-text: "";
    in property <string> text-stats: "";
    in-out property <string> export-path: "";
    in-out property <string> text-file-path: "";
    in-out property <string> voice: "female";
    in-out property <string> emotion: "neutral";
    in-out property <float> pitch: 0;
    in-out property <float> volume: 1.0;
    in-out property <float> speech-rate: 1.0;
    in-out property <float> pause-multiplier: 1.0;
    in-out property <string> auto-save-directory: "";
    in property <string> last-generated-file: "";
    // Dynamic voice and language lists built from the installed models.
    in property <[string]> voice-labels: ["Built-in engine (eSpeak NG)"];
    in property <[string]> voice-model-ids: [""];
    in-out property <int> voice-selected-index: 0;
    // Downloaded voice models grouped by language; each option label carries
    // its language prefix, and rows still drive the backend selection.
    in property <[VoiceRow]> voice-rows: [];
    in-out property <int> voice-row-selected-index: 0;
    callback voice-picked(int);
    in property <[string]> language-labels: [
        "Persian (fa)",
        "English (en)",
        "Arabic (ar)",
        "Turkish (tr)",
    ];
    in-out property <int> language-selected-index: 0;
    in property <string> installed-summary: "";

    callback speak(string);
    callback export-wav(string);
    callback export-mp3(string);
    callback load-text(string);
    callback open-export-folder(string);

    property <bool> builtin-engine: root.voice-model-ids[root.voice-selected-index] == "";

    property <[string]> voice-options: [
        "Female",
        "Male",
        "Child",
        "Whisper",
        "Grotesque",
    ];
    property <[string]> voice-values: [
        "female",
        "male",
        "child",
        "whisper",
        "grotesque",
    ];
    property <[string]> emotion-options: [
        "Neutral",
        "Happy",
        "Sad",
        "Formal",
        "Friendly",
        "Excited",
        "Calm",
    ];

    property <color> palette-surface: root.theme == "dark" ? #161e2c : #ffffff;
    property <color> palette-border: root.theme == "dark" ? #2c3a52 : #e2e8f0;
    property <color> palette-muted: root.theme == "dark" ? #8c98ab : #64748b;
    property <color> palette-text: root.theme == "dark" ? #f1f5f9 : #0f1b2d;
    property <color> palette-field: root.theme == "dark" ? #101722 : #f8fafc;
    property <color> palette-accent: root.theme == "dark" ? #1f2a51 : #eef2ff;
    property <color> palette-hover: root.theme == "dark" ? #1c2536 : #f1f5f9;

    background: root.palette-surface;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.palette-border;

    VerticalBox {
        padding: 22px;
        spacing: 12px;

        PageHeader {
            theme: root.theme;
            title: "Text to Speech";
            subtitle: "Natural voices, multilingual reading, and prosody control. Text stays on this device.";
            badge-text: "TTS";
            badge-color: #4f46e5;
        }

        TextEdit {
            text <=> root.speech-text;
            min-height: 180px;
            font-size: 16px;
            wrap: word-wrap;
        }

        Text {
            text: root.text-stats;
            font-size: 12px;
            color: root.palette-muted;
        }

        // Voice model, speaker, language, and tone selection
        Text {
            text: "VOICE & TONE";
            font-size: 10px;
            font-weight: 700;
            color: root.palette-muted;
        }
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Voice model (downloaded models, grouped by language)";
                font-size: 11px;
                color: root.palette-muted;
            }
            // Dropdown selector: every downloaded model is one option, grouped
            // by its language prefix, alongside the built-in engine.
            ComboBox {
                model: root.voice-labels;
                current-index <=> root.voice-selected-index;
                horizontal-stretch: 1;
            }
            Text {
                text: root.voice-labels.length <= 1
                    ? "Only the built-in engine is available. Download voice models in the Models tab to add languages here."
                    : "Installed by language: " + root.installed-summary
                        + "  ·  Piper (.onnx) voices can speak directly; other formats need a Piper-compatible export.";
                font-size: 11px;
                color: root.palette-muted;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Speaker voice (built-in engine)";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    enabled: root.builtin-engine;
                    model: root.voice-options;
                    current-index: root.voice-to-index(root.voice);
                    changed current-index => {
                        root.voice = root.voice-values[self.current-index];
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Language";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    model: root.language-labels;
                    current-index <=> root.language-selected-index;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Emotion";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    model: root.emotion-options;
                    current-index: root.emotion-to-index(root.emotion);
                    changed current-index => {
                        root.emotion = root.emotion-options[self.current-index].to-lowercase();
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // Prosody sliders: pitch, volume, speed, pauses
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Pitch: " + (root.pitch >= 0 ? "+" : "") + Math.round(root.pitch) + " (low ↔ high)";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.pitch;
                    minimum: -50;
                    maximum: 50;
                    step: 1;
                }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Volume: " + Math.round(root.volume * 100) + "%";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.volume;
                    minimum: 0.2;
                    maximum: 2.0;
                    step: 0.05;
                }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Speech speed: " + root.speech-rate + "x";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.speech-rate;
                    minimum: 0.5;
                    maximum: 2.0;
                    step: 0.05;
                }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Pause length: " + root.pause-multiplier + "x";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.pause-multiplier;
                    minimum: 0.5;
                    maximum: 4.0;
                    step: 0.5;
                }
            }
        }

        Rectangle { height: 1px; background: root.palette-border; }

        // Generated audio files
        Text {
            text: "AUDIO FILES";
            font-size: 10px;
            font-weight: 700;
            color: root.palette-muted;
        }
        Rectangle {
            height: 46px;
            border-radius: 10px;
            background: root.palette-field;
            border-width: 1px;
            border-color: root.palette-border;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                LineEdit {
                    text <=> root.auto-save-directory;
                    placeholder-text: "Auto-save directory for spoken audio";
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Open folder";
                    clicked => {
                        root.open-export-folder(root.auto-save-directory);
                    }
                }
            }
        }
        Text {
            text: root.last-generated-file == "" ?
                "Speaking automatically saves a downloadable WAV file in the folder above." :
                "Last file: " + root.last-generated-file;
            font-size: 11px;
            color: root.palette-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 46px;
                border-radius: 10px;
                background: root.palette-field;
                border-width: 1px;
                border-color: root.palette-border;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: 7px;
                    spacing: 8px;
                    LineEdit {
                        text <=> root.export-path;
                        placeholder-text: "Export file path (.wav or .mp3)";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Export WAV";
                        clicked => {
                            root.export-wav(root.export-path);
                        }
                    }
                    Button {
                        text: "Export MP3";
                        clicked => {
                            root.export-mp3(root.export-path);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 46px;
            border-radius: 10px;
            background: root.palette-field;
            border-width: 1px;
            border-color: root.palette-border;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                LineEdit {
                    text <=> root.text-file-path;
                    placeholder-text: "Path to a UTF-8 .txt file (books, articles, documents)";
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Load text file";
                    clicked => {
                        root.load-text(root.text-file-path);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            Button {
                text: "Speak";
                height: 42px;
                primary: true;
                clicked => {
                    root.speak(root.speech-text);
                }
            }
        }
    }
}
