import { Button, ComboBox, LineEdit, Slider, TextEdit, VerticalBox } from "std-widgets.slint";
import { PageHeader } from "../components/page-header.slint";

// One row of the categorized voice-model list: a language header or a
// selectable voice entry mapped back to its entry by entry-index.
export struct VoiceRow {
    is-header: bool,
    text: string,
    entry-index: int,
    selected: bool,
}

// Workspace card for advanced speaking, prosody control, and audio export.
export component TextToSpeechTab inherits Rectangle {
    pure function voice-to-index(voice: string) -> int {
        return voice == "female" ? 0 : voice == "male" ? 1 : -1;
    }
    pure function voice-style-to-index(style: string) -> int {
        return style == "standard" ? 0 : style == "calm" ? 1 :
            style == "formal" ? 2 : style == "friendly" ? 3 : -1;
    }
    pure function speech-tone-to-index(tone: string) -> int {
        return tone == "neutral" ? 0 : tone == "gentle" ? 1 :
            tone == "informative" ? 2 : tone == "conversational" ? 3 : -1;
    }

    in property <string> theme: "system";
    in-out property <string> speech-text: "";
    in property <string> text-stats: "";
    in-out property <string> export-path: "";
    in-out property <string> text-file-path: "";
    in-out property <string> voice: "female";
    in-out property <string> voice-style: "standard";
    in-out property <string> speech-tone: "neutral";
    in-out property <float> pitch: 0;
    in-out property <float> volume: 1.0;
    in-out property <float> speech-rate: 1.0;
    in-out property <float> pause-sentence: 0.5;
    in-out property <float> pause-paragraph: 1.2;
    in-out property <string> auto-save-directory: "";
    in property <string> last-generated-file: "";
    // Dynamic voice and language lists built from the installed models.
    in property <[string]> voice-labels: ["Built-in engine (eSpeak NG)"];
    in property <[string]> voice-model-ids: [""];
    in-out property <int> voice-selected-index: 0;
    // Downloaded voice models grouped by language; each option label carries
    // its language prefix, and rows still drive the backend selection.
    in property <[VoiceRow]> voice-rows: [];
    in-out property <int> voice-row-selected-index: 0;
    callback voice-picked(int);
    in property <[string]> language-labels: [
        "Persian (fa)",
        "English (en)",
        "Arabic (ar)",
        "Turkish (tr)",
    ];
    in-out property <int> language-selected-index: 0;
    in property <string> installed-summary: "";

    callback speak(string);
    callback export-wav(string);
    callback export-mp3(string);
    callback load-text(string);
    callback open-export-folder(string);

    property <bool> builtin-engine: root.voice-model-ids[root.voice-selected-index] == "";

    // Built-in speaker voices: Male (natural, calm, standard) and Female
    // (natural, gentle). Both remain available alongside downloaded models.
    property <[string]> voice-options: [
        "Female · natural, gentle",
        "Male · natural, calm, standard",
    ];
    property <[string]> voice-values: [
        "female",
        "male",
    ];
    // Voice Style controls overall delivery character.
    property <[string]> voice-style-options: [
        "Standard",
        "Calm",
        "Formal",
        "Friendly",
    ];
    property <[string]> voice-style-values: [
        "standard",
        "calm",
        "formal",
        "friendly",
    ];
    // Speech Tone controls the emotional coloring of the reading.
    property <[string]> speech-tone-options: [
        "Neutral",
        "Gentle",
        "Informative",
        "Conversational",
    ];
    property <[string]> speech-tone-values: [
        "neutral",
        "gentle",
        "informative",
        "conversational",
    ];

    property <color> palette-surface: root.theme == "dark" ? #161e2c : #ffffff;
    property <color> palette-border: root.theme == "dark" ? #2c3a52 : #e2e8f0;
    property <color> palette-muted: root.theme == "dark" ? #8c98ab : #64748b;
    property <color> palette-text: root.theme == "dark" ? #f1f5f9 : #0f1b2d;
    property <color> palette-field: root.theme == "dark" ? #101722 : #f8fafc;
    property <color> palette-accent: root.theme == "dark" ? #1f2a51 : #eef2ff;
    property <color> palette-hover: root.theme == "dark" ? #1c2536 : #f1f5f9;
    property <color> palette-highlight: #4f46e5;

    background: root.palette-surface;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.palette-border;

    VerticalBox {
        padding: 22px;
        spacing: 12px;

        PageHeader {
            theme: root.theme;
            title: "Text to Speech";
            subtitle: "Natural voices, multilingual reading, and prosody control. Text stays on this device.";
            badge-text: "TTS";
            badge-color: root.palette-highlight;
        }

        TextEdit {
            text <=> root.speech-text;
            min-height: 140px;
            font-size: 16px;
            wrap: word-wrap;
        }

        Text {
            text: root.text-stats;
            font-size: 12px;
            color: root.palette-muted;
        }

        // ─── Voice Settings ─── the most important section of the software
        Rectangle { height: 1px; background: root.palette-border; }
        Text {
            text: "VOICE SETTINGS";
            font-size: 11px;
            font-weight: 700;
            color: root.palette-highlight;
        }
        Text {
            text: "Pick a speaker voice and refine style, tone, speed, pitch, volume, and natural pauses.";
            font-size: 11px;
            color: root.palette-muted;
            wrap: word-wrap;
        }

        // Downloaded voice models, grouped by language. Kept intact.
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Voice model (downloaded models, grouped by language)";
                font-size: 11px;
                color: root.palette-muted;
            }
            ComboBox {
                model: root.voice-labels;
                current-index <=> root.voice-selected-index;
                horizontal-stretch: 1;
            }
            Text {
                text: root.voice-labels.length <= 1
                    ? "Only the built-in engine is available. Download voice models in the Models tab to add languages here."
                    : "Installed by language: " + root.installed-summary
                        + "  ·  Piper (.onnx) voices can speak directly; other formats need a Piper-compatible export.";
                font-size: 11px;
                color: root.palette-muted;
                wrap: word-wrap;
            }
        }

        // Row 1: speaker voice (male/female), language, voice style, speech tone.
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "Select Voice (Male / Female)";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    enabled: root.builtin-engine;
                    model: root.voice-options;
                    current-index: root.voice-to-index(root.voice);
                    changed current-index => {
                        root.voice = root.voice-values[self.current-index];
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "Language";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    model: root.language-labels;
                    current-index <=> root.language-selected-index;
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "Voice Style";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    model: root.voice-style-options;
                    current-index: root.voice-style-to-index(root.voice-style);
                    changed current-index => {
                        root.voice-style = root.voice-style-values[self.current-index];
                    }
                }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: "Speech Tone";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                ComboBox {
                    model: root.speech-tone-options;
                    current-index: root.speech-tone-to-index(root.speech-tone);
                    changed current-index => {
                        root.speech-tone = root.speech-tone-values[self.current-index];
                    }
                }
            }
        }

        // Voice style / tone descriptions so users see what each option means.
        Text {
            text: "Style: standard · calm · formal · friendly    ·    Tone: neutral · gentle · informative · conversational";
            font-size: 11px;
            color: root.palette-muted;
            wrap: word-wrap;
        }

        // Row 2: prosody sliders – speech speed, pitch, volume.
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Speech Speed: " + root.speech-rate + "x  (0.5x ↔ 2x)";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.speech-rate;
                    minimum: 0.5;
                    maximum: 2.0;
                    step: 0.05;
                }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Pitch: " + (root.pitch >= 0 ? "+" : "") + Math.round(root.pitch) + "  (deeper ↔ higher)";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.pitch;
                    minimum: -50;
                    maximum: 50;
                    step: 1;
                }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Volume: " + Math.round(root.volume * 100) + "%  (output intensity)";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.volume;
                    minimum: 0.2;
                    maximum: 2.0;
                    step: 0.05;
                }
            }
        }

        // Row 3: natural pauses – between sentences and between paragraphs.
        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Pause Between Sentences: " + Math.round(root.pause-sentence * 10) / 10 + "s";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.pause-sentence;
                    minimum: 0.2;
                    maximum: 3.0;
                    step: 0.1;
                }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Pause Between Paragraphs: " + Math.round(root.pause-paragraph * 10) / 10 + "s";
                    font-size: 11px;
                    color: root.palette-muted;
                }
                Slider {
                    value <=> root.pause-paragraph;
                    minimum: 0.5;
                    maximum: 5.0;
                    step: 0.25;
                }
            }
        }

        Rectangle { height: 1px; background: root.palette-border; }

        // Generated audio files
        Text {
            text: "AUDIO FILES";
            font-size: 10px;
            font-weight: 700;
            color: root.palette-muted;
        }
        Rectangle {
            height: 46px;
            border-radius: 10px;
            background: root.palette-field;
            border-width: 1px;
            border-color: root.palette-border;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                LineEdit {
                    text <=> root.auto-save-directory;
                    placeholder-text: "Auto-save directory for spoken audio";
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Open folder";
                    clicked => {
                        root.open-export-folder(root.auto-save-directory);
                    }
                }
            }
        }
        Text {
            text: root.last-generated-file == "" ?
                "Speaking automatically saves a downloadable WAV file in the folder above." :
                "Last file: " + root.last-generated-file;
            font-size: 11px;
            color: root.palette-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 46px;
                border-radius: 10px;
                background: root.palette-field;
                border-width: 1px;
                border-color: root.palette-border;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: 7px;
                    spacing: 8px;
                    LineEdit {
                        text <=> root.export-path;
                        placeholder-text: "Export file path (.wav or .mp3)";
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Export WAV";
                        clicked => {
                            root.export-wav(root.export-path);
                        }
                    }
                    Button {
                        text: "Export MP3";
                        clicked => {
                            root.export-mp3(root.export-path);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 46px;
            border-radius: 10px;
            background: root.palette-field;
            border-width: 1px;
            border-color: root.palette-border;
            HorizontalLayout {
                padding: 7px;
                spacing: 8px;
                LineEdit {
                    text <=> root.text-file-path;
                    placeholder-text: "Path to a UTF-8 .txt file (books, articles, documents)";
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Load text file";
                    clicked => {
                        root.load-text(root.text-file-path);
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            Button {
                text: "Speak";
                height: 42px;
                primary: true;
                clicked => {
                    root.speak(root.speech-text);
                }
            }
        }
    }
}
