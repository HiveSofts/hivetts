import { Button, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

export struct HubModel {
    id: string,
    author: string,
    task: string,
    category-label: string,
    description: string,
    languages: string,
    tags: string,
    framework: string,
    architecture: string,
    size-label: string,
    stats: string,
    license: string,
    compatibility: string,
    installed: bool,
    deletable: bool,
    local-path: string,
}

export struct LanguageOption {
    name: string,
    code: string,
}

export component ModelsTab inherits Rectangle {
    in property <string> theme: "system";
    in-out property <[HubModel]> models: [];
    in-out property <string> query: "";
    in-out property <string> language-filter: "";
    in-out property <string> language-label: "";
    in-out property <string> language-search: "";
    in-out property <string> active-category: "all";
    in-out property <string> download-progress-text: "";
    in-out property <float> download-progress: 0;
    in-out property <string> active-download-id: "";
    in-out property <string> pending-delete-id: "";
    callback refresh-models(string, string, string, string, string, string);
    callback search-languages(string);
    callback download-model(string);
    callback download-hub-model(string, string);
    callback cancel-download(string);
    callback open-model-folder(string);
    callback open-hub-repository(string);
    callback delete-model(string);

    in property <[LanguageOption]> language-options: [];
    in property <[string]> language-option-labels: [];
    property <int> card-columns: root.width < 720px ? 1 : 2;
    property <length> card-width: root.width < 720px
        ? max(0px, root.width - 48px)
        : (root.width - 74px) / 2;

    changed language-search => {
        root.search-languages(root.language-search);
    }

    changed query => {
        root.refresh-models(root.query, root.active-category, "",
            root.language-filter, "", "");
    }

    background: root.theme == "dark" ? #1b202b : #ffffff;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.theme == "dark" ? #343b4b : #e2e8f0;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 10px;
            VerticalBox {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "Hugging Face Model Hub";
                    font-size: 21px;
                    font-weight: 700;
                    color: root.theme == "dark" ? #f8fafc : #172338;
                    wrap: word-wrap;
                }
                Text {
                    text: "Discover and manage speech models on this device";
                    color: root.theme == "dark" ? #aab4c5 : #64748b;
                    wrap: word-wrap;
                }
            }
            Rectangle { }
            Button {
                text: "Refresh";
                height: 28px;
                clicked => {
                    root.refresh-models(root.query, root.active-category, "",
                        root.language-filter, "", "");
                }
            }
        }

        VerticalBox {
            spacing: 6px;
            HorizontalBox {
                spacing: 6px;
                LineEdit {
                    text <=> root.query;
                    height: 32px;
                    horizontal-stretch: 1;
                    placeholder-text: "Search models";
                }
                Button {
                    text: "🔍";
                    width: 32px;
                    height: 32px;
                    clicked => {
                        root.refresh-models(root.query, root.active-category, "",
                            root.language-filter, "", "");
                    }
                }
            }
        }

        if root.download-progress-text != "": VerticalBox {
            spacing: 4px;
            HorizontalBox {
                spacing: 6px;
                Text {
                    text: root.download-progress-text;
                    color: root.theme == "dark" ? #ddd6fe : #5b21b6;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if root.active-download-id != "": Button {
                    text: "Cancel";
                    height: 26px;
                    clicked => { root.cancel-download(root.active-download-id); }
                }
            }
            Rectangle {
                height: 6px;
                background: root.theme == "dark" ? #303748 : #e2e8f0;
                border-radius: 3px;
                Rectangle {
                    width: parent.width * root.download-progress;
                    height: parent.height;
                    background: #8b5cf6;
                    border-radius: 3px;
                }
            }
        }

        ScrollView {
            content-width: root.width - 32px;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            GridLayout {
                spacing: 10px;
                for model[index] in root.models: Rectangle {
                    row: index / root.card-columns;
                    col: Math.mod(index, root.card-columns);
                    width: root.card-width;
                    background: root.theme == "dark" ? #222a38 : #f8fafc;
                    border-color: root.theme == "dark" ? #384357 : #e2e8f0;
                    border-width: 1px;
                    border-radius: 9px;
                    VerticalBox {
                        min-width: 0px;
                        padding: 10px;
                        spacing: 4px;
                        HorizontalBox {
                            spacing: 8px;
                            Text {
                                text: model.id;
                                font-size: 16px;
                                font-weight: 650;
                                color: root.theme == "dark" ? #f8fafc : #172338;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: model.installed ? "INSTALLED" : "HUGGING FACE";
                                color: model.installed ? #34d399 : #a78bfa;
                                font-size: 11px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: model.author + "  ·  " + model.category-label;
                            color: root.theme == "dark" ? #cbd5e1 : #475569;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Languages: " + model.languages + "    Framework: " + model.framework;
                            color: root.theme == "dark" ? #cbd5e1 : #475569;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        // Text {
                        //     text: "Tags: " + model.tags;
                        //     color: root.theme == "dark" ? #aab4c5 : #64748b;
                        //     wrap: word-wrap;
                        //     horizontal-stretch: 1;
                        // }
                        Text {
                            text: "Architecture: " + model.architecture;
                            color: root.theme == "dark" ? #cbd5e1 : #475569;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: model.stats;
                            color: root.theme == "dark" ? #cbd5e1 : #475569;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "File size: " + model.size-label;
                            color: root.theme == "dark" ? #cbd5e1 : #475569;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "License: " + model.license;
                            color: root.theme == "dark" ? #cbd5e1 : #475569;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "Hardware compatibility: " + model.compatibility;
                            color: model.compatibility == "Compatible" ? #34d399 : #fbbf24;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        if model.installed: Text {
                            text: "Local: " + model.local-path;
                            color: root.theme == "dark" ? #aab4c5 : #64748b;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                        VerticalBox {
                            min-width: 0px;
                            spacing: 6px;
                            if model.installed: Button {
                                text: "Open Folder";
                                height: 28px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                max-width: root.card-width - 20px;
                                clicked => { root.open-model-folder(model.local-path); }
                            }
                            if model.installed && model.deletable: Button {
                                text: root.pending-delete-id == model.id ? "Confirm delete" : "Delete";
                                height: 28px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                max-width: root.card-width - 20px;
                                clicked => {
                                    if (root.pending-delete-id == model.id) {
                                        root.delete-model(model.id);
                                        root.pending-delete-id = "";
                                    } else {
                                        root.pending-delete-id = model.id;
                                    }
                                }
                            }
                            if model.installed && model.deletable && root.pending-delete-id == model.id: Button {
                                text: "Keep";
                                height: 28px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                max-width: root.card-width - 20px;
                                clicked => { root.pending-delete-id = ""; }
                            }
                            if !model.installed: Button {
                                text: "Download";
                                height: 28px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                max-width: root.card-width - 20px;
                                enabled: root.active-download-id == "";
                                clicked => { root.download-hub-model(model.id, model.task); }
                            }
                            Button {
                                text: "View on Hugging Face";
                                height: 28px;
                                horizontal-stretch: 1;
                                min-width: 0px;
                                max-width: root.card-width - 20px;
                                clicked => { root.open-hub-repository(model.id); }
                            }
                        }
                    }
                }
            }
        }
        Text {
            text: "Compatibility is marked unknown unless available system memory indicates a resource limitation. Downloads require curl; gated repositories need HF_TOKEN.";
            color: root.theme == "dark" ? #8490a4 : #64748b;
            wrap: word-wrap;
        }
    }
}
