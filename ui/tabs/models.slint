import { Button, LineEdit, ProgressIndicator, ScrollView, VerticalBox } from "std-widgets.slint";
import { PageHeader } from "../components/page-header.slint";

export struct HubModel {
    id: string,
    author: string,
    task: string,
    category-label: string,
    description: string,
    languages: string,
    tags: string,
    framework: string,
    architecture: string,
    size-label: string,
    stats: string,
    license: string,
    compatibility: string,
    installed: bool,
    deletable: bool,
    local-path: string,
}

export struct LanguageOption {
    name: string,
    code: string,
}

// Workspace card for discovering and managing speech models.
export component ModelsTab inherits Rectangle {
    in property <string> theme: "system";
    in-out property <[HubModel]> models: [];
    in-out property <string> query: "";
    in-out property <string> language-filter: "";
    in-out property <string> language-label: "";
    in-out property <string> language-search: "";
    in-out property <string> active-category: "all";
    in-out property <string> download-progress-text: "";
    in-out property <float> download-progress: 0;
    in property <bool> download-progress-indeterminate: false;
    in-out property <string> active-download-id: "";
    in-out property <string> pending-delete-id: "";
    in property <string> installed-summary: "";
    callback refresh-models(string, string, string, string, string, string);
    callback search-languages(string);
    callback download-model(string);
    callback download-hub-model(string, string);
    callback cancel-download(string);
    callback open-model-folder(string);
    callback open-hub-repository(string);
    callback delete-model(string);

    in property <[LanguageOption]> language-options: [];
    in property <[string]> language-option-labels: [];
    property <[string]> categories: ["all", "tts", "stt", "installed"];
    property <[string]> category-labels: ["All", "TTS", "STT", "Installed"];
    property <int> card-columns: root.width < 860px ? 1 : 2;
    property <length> card-width: root.width < 860px
        ? max(0px, root.width - 64px)
        : (root.width - 90px) / 2;

    property <color> palette-surface: root.theme == "dark" ? #161e2c : #ffffff;
    property <color> palette-border: root.theme == "dark" ? #2c3a52 : #e2e8f0;
    property <color> palette-muted: root.theme == "dark" ? #8c98ab : #64748b;
    property <color> palette-text: root.theme == "dark" ? #f1f5f9 : #0f1b2d;
    property <color> palette-card: root.theme == "dark" ? #1d2636 : #f8fafc;
    property <color> palette-field: root.theme == "dark" ? #101722 : #f4f7fc;
    property <color> palette-accent: #4f46e5;
    property <color> palette-ok: #10b981;
    property <color> palette-warn: #f59e0b;

    changed language-search => {
        root.search-languages(root.language-search);
    }

    changed query => {
        root.refresh-models(root.query, root.active-category, "",
            root.language-filter, "", "");
    }

    background: root.palette-surface;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.palette-border;

    VerticalBox {
        padding: 22px;
        spacing: 12px;

        PageHeader {
            theme: root.theme;
            title: "Model Hub";
            subtitle: "Discover and manage speech models on this device.";
            badge-text: "HUGGING FACE";
            badge-color: #7c3aed;
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.query;
                height: 38px;
                horizontal-stretch: 1;
                placeholder-text: "Search models by name, language, license…";
            }
            Button {
                text: "Search";
                height: 38px;
                clicked => {
                    root.refresh-models(root.query, root.active-category, "",
                        root.language-filter, "", "");
                }
            }
            Button {
                text: "Refresh";
                height: 38px;
                clicked => {
                    root.refresh-models(root.query, root.active-category, "",
                        root.language-filter, "", "");
                }
            }
        }

        // Category filter chips
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for category[index] in root.categories: Rectangle {
                width: 78px;
                height: 30px;
                border-radius: 15px;
                background: root.active-category == category
                    ? root.palette-accent : root.palette-field;
                border-width: 1px;
                border-color: root.active-category == category
                    ? root.palette-accent : root.palette-border;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.active-category = category;
                        root.refresh-models(root.query, category, "",
                            root.language-filter, "", "");
                    }
                }
                lbl := Text {
                    text: root.category-labels[index];
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 12px;
                    font-weight: 600;
                    color: root.active-category == category
                        ? #ffffff : root.palette-muted;
                }
            }
        }

        // Downloaded models categorized by language
        if root.installed-summary != "": Rectangle {
            border-radius: 10px;
            background: root.palette-field;
            border-width: 1px;
            border-color: root.palette-border;
            VerticalBox {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 4px;
                Text {
                    text: "INSTALLED BY LANGUAGE";
                    font-size: 10px;
                    font-weight: 700;
                    color: root.palette-muted;
                }
                Text {
                    text: root.installed-summary;
                    font-size: 12px;
                    color: root.palette-text;
                    wrap: word-wrap;
                }
            }
        }

        // Download progress banner
        if root.download-progress-text != "": Rectangle {
            background: root.theme == "dark" ? #221f3a : #f3f0ff;
            border-color: root.theme == "dark" ? #453d67 : #ddd6fe;
            border-width: 1px;
            border-radius: 10px;
            VerticalBox {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.download-progress-text;
                        color: root.theme == "dark" ? #e2e8f0 : #3b3563;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                    if root.active-download-id != "": Button {
                        text: "Cancel";
                        height: 26px;
                        clicked => { root.cancel-download(root.active-download-id); }
                    }
                }
                ProgressIndicator {
                    height: 6px;
                    progress: root.download-progress;
                    indeterminate: root.download-progress-indeterminate;
                }
            }
        }

        ScrollView {
            content-width: root.width - 46px;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            GridLayout {
                spacing: 12px;
                for model[index] in root.models: Rectangle {
                    row: index / root.card-columns;
                    col: Math.mod(index, root.card-columns);
                    width: root.card-width;
                    background: root.palette-card;
                    border-color: root.palette-border;
                    border-width: 1px;
                    border-radius: 12px;
                    VerticalBox {
                        min-width: 0px;
                        padding: 14px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: model.id;
                                font-size: 15px;
                                font-weight: 700;
                                color: root.palette-text;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            Rectangle {
                                width: 80px;
                                height: 22px;
                                border-radius: 11px;
                                background: model.installed ? #064e3b : (root.theme == "dark" ? #3b2f63 : #ede9fe);
                                Text {
                                    text: model.installed ? "INSTALLED" : "HUB";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: model.installed ? #34d399 : #8b5cf6;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: model.author + "  ·  " + model.category-label;
                            color: root.palette-muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: model.languages;
                            color: root.palette-text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: model.framework + " · " + model.architecture;
                                color: root.palette-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: model.size-label;
                                color: root.palette-muted;
                                font-size: 12px;
                            }
                        }
                        Text {
                            text: model.stats + "  ·  " + model.license;
                            color: root.palette-muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: model.compatibility;
                            color: model.compatibility == "Compatible" ? root.palette-ok : root.palette-warn;
                            font-size: 12px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        if model.installed: Text {
                            text: model.local-path;
                            color: root.palette-muted;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 1px; background: root.palette-border; }
                        HorizontalLayout {
                            spacing: 6px;
                            if model.installed: Button {
                                text: "Open";
                                height: 30px;
                                clicked => { root.open-model-folder(model.local-path); }
                            }
                            if model.installed && model.deletable: Button {
                                text: root.pending-delete-id == model.id ? "Confirm" : "Delete";
                                height: 30px;
                                clicked => {
                                    if (root.pending-delete-id == model.id) {
                                        root.delete-model(model.id);
                                        root.pending-delete-id = "";
                                    } else {
                                        root.pending-delete-id = model.id;
                                    }
                                }
                            }
                            if model.installed && model.deletable && root.pending-delete-id == model.id: Button {
                                text: "Keep";
                                height: 30px;
                                clicked => { root.pending-delete-id = ""; }
                            }
                            if !model.installed: Button {
                                text: "Download";
                                height: 30px;
                                enabled: root.active-download-id == "";
                                clicked => { root.download-hub-model(model.id, model.task); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "HF Page";
                                height: 30px;
                                clicked => { root.open-hub-repository(model.id); }
                            }
                        }
                    }
                }
            }
        }
        Text {
            text: "Compatibility is marked unknown unless available system memory indicates a resource limitation. Downloads require curl; gated repositories need HF_TOKEN.";
            color: root.palette-muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
